@implements IDisposable
@inject NavigationManager Navigation

<nav class="tabbar" aria-label="Main">
    <div class="rail-brand">
        <span class="mark" aria-hidden="true">FH</span>
        <span>Family Hub</span>
    </div>

    <NavLink class="tab" href="" Match="NavLinkMatch.All">
        <Icon Name="home" />
        <span>Home</span>
    </NavLink>
    <NavLink class="tab" href="chores">
        <Icon Name="chores" />
        <span>Chores</span>
    </NavLink>
    <NavLink class="tab" href="expiry">
        <Icon Name="expiry" />
        <span>Expiry</span>
    </NavLink>
    <NavLink class="tab" href="medications">
        <Icon Name="meds" />
        <span>Meds</span>
    </NavLink>

    <NavLink class="tab tab-secondary" href="warranties">
        <Icon Name="warranty" />
        <span>Warranties</span>
    </NavLink>
    <NavLink class="tab tab-secondary" href="first-aid">
        <Icon Name="firstaid" />
        <span>First aid</span>
    </NavLink>
    <NavLink class="tab tab-secondary" href="settings">
        <Icon Name="settings" />
        <span>Settings</span>
    </NavLink>

    <button type="button" class="tab tab-more" @onclick="() => _moreOpen = true">
        <Icon Name="more" />
        <span>More</span>
    </button>
</nav>

<Sheet @bind-Open="_moreOpen" Title="More">
    <div class="card">
        <a class="row row-link" href="warranties">
            <span class="avatar">
                <Icon Name="warranty" />
            </span>
            <span class="row-main">
                <span class="row-title">Warranties</span>
                <span class="row-sub">Receipts and cover dates</span>
            </span>
            <span class="row-trail row-chevron">
                <Icon Name="chevron" />
            </span>
        </a>
        <a class="row row-link" href="first-aid">
            <span class="avatar">
                <Icon Name="firstaid" />
            </span>
            <span class="row-main">
                <span class="row-title">First aid</span>
                <span class="row-sub">Kit stock and expiry</span>
            </span>
            <span class="row-trail row-chevron">
                <Icon Name="chevron" />
            </span>
        </a>
        <a class="row row-link" href="settings">
            <span class="avatar">
                <Icon Name="settings" />
            </span>
            <span class="row-main">
                <span class="row-title">Settings</span>
                <span class="row-sub">Household integrations</span>
            </span>
            <span class="row-trail row-chevron">
                <Icon Name="chevron" />
            </span>
        </a>
    </div>
</Sheet>

@code {
    private bool _moreOpen;

    protected override void OnInitialized() => Navigation.LocationChanged += CloseMore;

    private void CloseMore(object? sender, LocationChangedEventArgs args)
    {
        if (!_moreOpen)
        {
            return;
        }

        _moreOpen = false;
        StateHasChanged();
    }

    public void Dispose() => Navigation.LocationChanged -= CloseMore;
}
