<div class="top-row navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <span class="brand-mark" aria-hidden="true">FH</span>
            <span>Family Hub</span>
        </a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="nav-symbol" aria-hidden="true">⌂</span> Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="chores">
                <span class="nav-symbol" aria-hidden="true">✓</span> Chores
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="expiry">
                <span class="nav-symbol" aria-hidden="true">◷</span> Expiry
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="warranties">
                <span class="nav-symbol" aria-hidden="true">▣</span> Warranties
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="medications">
                <span class="nav-symbol nav-symbol-text" aria-hidden="true">Rx</span> Medications
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="first-aid">
                <span class="nav-symbol" aria-hidden="true">+</span> First Aid
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="settings">
                <span class="nav-symbol" aria-hidden="true">⚙</span> Settings
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
