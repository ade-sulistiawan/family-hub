@page "/first-aid"
@using FamilyHub.Services
@inject FirstAidClient FirstAidClient
@inject HouseholdClient HouseholdClient
@inject NavigationManager Navigation

<PageTitle>First-Aid Kit | Family Hub</PageTitle>

<AppBar Title="First aid">
    <Trail>
        <button type="button" class="icon-btn" aria-label="Add stock" @onclick="() => _sheetOpen = true">
            <Icon Name="plus" />
        </button>
    </Trail>
</AppBar>

<div class="page">
    @if (_isLoading)
    {
        <div class="state" role="status">Loading stock</div>
    }
    else if (_loadError is not null)
    {
        <div class="notice" role="alert">
            <span>@_loadError</span>
            <button type="button" class="btn-text" @onclick="LoadAsync">Retry</button>
        </div>
    }
    else
    {
        <div class="section-head">
            <h2>Kit inventory</h2>
            <span>@_items.Count</span>
        </div>
        <div class="card">
            @if (_items.Count == 0)
            {
                <div class="empty">
                    <strong>Kit is empty</strong>
                    <span>Tap + to add your first supply.</span>
                </div>
            }
            else
            {
                @foreach (var item in _items)
                {
                    var isLow = item.Quantity <= item.LowStockThreshold;
                    <button type="button" class="row row-link" @onclick="() => OpenEdit(item)">
                        <div class="datechip @(isLow ? "is-alert" : null)">
                            <span>Qty</span>
                            <strong>@item.Quantity</strong>
                        </div>
                        <div class="row-main">
                            <div class="row-title">@item.Name</div>
                            <div class="row-sub">Expires @item.ExpiresOn.ToString("d MMM yyyy")</div>
                        </div>
                        <div class="row-trail">
                            <span class="chip @(isLow ? "chip-danger" : null)">
                                @(isLow ? "Low stock" : $"Min {item.LowStockThreshold}")
                            </span>
                        </div>
                    </button>
                }
            }
        </div>
    }
</div>

<Sheet @bind-Open="_sheetOpen" Title="New first-aid stock">
    <form class="fields" @onsubmit="CreateAsync" @onsubmit:preventDefault>
        <label class="field">
            <span>Item</span>
            <input required maxlength="120" placeholder="e.g. Adhesive bandages" @bind="_name" />
        </label>
        <div class="field-pair">
            <label class="field">
                <span>Quantity</span>
                <input type="number" min="0" required @bind="_quantity" />
            </label>
            <label class="field">
                <span>Low-stock at</span>
                <input type="number" min="0" required @bind="_lowStockThreshold" />
            </label>
        </div>
        <div class="field-pair">
            <label class="field">
                <span>Expires on</span>
                <input type="date" required @bind="_expiresOn" />
            </label>
            <label class="field">
                <span>Lead Time (days)</span>
                <input type="number" min="0" max="3650" required @bind="_leadTimeDays" />
            </label>
        </div>
        <button type="submit" class="btn btn-primary btn-block" disabled="@_isSaving">
            @(_isSaving ? "Adding" : "Add stock")
        </button>
    </form>
    @if (_saveError is not null)
    {
        <p class="form-error" role="alert">@_saveError</p>
    }
</Sheet>

<Sheet @bind-Open="_editSheetOpen" Title="Edit stock">
    <form class="fields" @onsubmit="UpdateAsync" @onsubmit:preventDefault>
        <label class="field">
            <span>Item</span>
            <input required maxlength="120" @bind="_editName" />
        </label>
        <div class="field-pair">
            <label class="field">
                <span>Quantity</span>
                <input type="number" min="0" required @bind="_editQuantity" />
            </label>
            <label class="field">
                <span>Low-stock at</span>
                <input type="number" min="0" required @bind="_editLowStockThreshold" />
            </label>
        </div>
        <div class="field-pair">
            <label class="field">
                <span>Expires on</span>
                <input type="date" required @bind="_editExpiresOn" />
            </label>
            <label class="field">
                <span>Lead Time (days)</span>
                <input type="number" min="0" max="3650" required @bind="_editLeadTimeDays" />
            </label>
        </div>
        <button type="submit" class="btn btn-primary btn-block" disabled="@_isSaving">
            @(_isSaving ? "Saving" : "Save changes")
        </button>
        <button type="button" class="btn-text" @onclick="() => _confirmDeleteOpen = true">Delete item</button>
    </form>
    @if (_editError is not null)
    {
        <p class="form-error" role="alert">@_editError</p>
    }
</Sheet>

<ConfirmDialog @bind-Open="_confirmDeleteOpen"
               Title="Delete item"
               Message="@_deleteMessage"
               OnConfirm="DeleteAsync"
               Error="@_deleteError"
               IsBusy="_isDeleting" />

@code {
    private IReadOnlyList<FirstAidItem> _items = [];
    private string _name = string.Empty;
    private int _quantity = 1;
    private int _lowStockThreshold = 2;
    private DateOnly _expiresOn = DateOnly.FromDateTime(DateTime.Today.AddYears(1));
    private int _leadTimeDays = 30;
    private string? _loadError;
    private string? _saveError;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _sheetOpen;

    private FirstAidItem? _editItem;
    private string _editName = string.Empty;
    private int _editQuantity;
    private int _editLowStockThreshold;
    private DateOnly _editExpiresOn;
    private int _editLeadTimeDays;
    private string? _editError;
    private bool _editSheetOpen;
    private bool _confirmDeleteOpen;
    private string? _deleteError;
    private bool _isDeleting;
    private string _deleteMessage = string.Empty;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadError = null;
        try
        {
            if (await HouseholdClient.GetMineAsync() is null)
            {
                _loadError = "Complete Household setup before tracking first-aid stock.";
                return;
            }
            _items = await FirstAidClient.GetAllAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login?returnUrl=/first-aid", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _loadError = "First-aid stock could not be loaded.";
        }
        finally { _isLoading = false; }
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_name)) return;
        _isSaving = true;
        _saveError = null;
        try
        {
            await FirstAidClient.CreateAsync(_name.Trim(), _quantity, _lowStockThreshold, _expiresOn, _leadTimeDays);
            _name = string.Empty;
            _items = await FirstAidClient.GetAllAsync();
            _sheetOpen = false;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login?returnUrl=/first-aid", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _saveError = "The first-aid Item could not be added.";
        }
        finally { _isSaving = false; }
    }

    private void OpenEdit(FirstAidItem item)
    {
        _editItem = item;
        _editName = item.Name;
        _editQuantity = item.Quantity;
        _editLowStockThreshold = item.LowStockThreshold;
        _editExpiresOn = item.ExpiresOn;
        _editLeadTimeDays = item.LeadTimeDays;
        _editError = null;
        _deleteError = null;
        _deleteMessage = $"Delete {item.Name}? This can't be undone.";
        _editSheetOpen = true;
    }

    private async Task UpdateAsync()
    {
        if (_editItem is null || string.IsNullOrWhiteSpace(_editName)) return;
        _isSaving = true;
        _editError = null;
        try
        {
            await FirstAidClient.UpdateAsync(
                _editItem.ItemId,
                _editName.Trim(),
                _editQuantity,
                _editLowStockThreshold,
                _editExpiresOn,
                _editLeadTimeDays);
            _items = await FirstAidClient.GetAllAsync();
            _editSheetOpen = false;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login?returnUrl=/first-aid", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _editError = "The item could not be saved.";
        }
        finally { _isSaving = false; }
    }

    private async Task DeleteAsync()
    {
        if (_editItem is null) return;
        _isDeleting = true;
        _deleteError = null;
        try
        {
            await FirstAidClient.DeleteAsync(_editItem.ItemId);
            _items = await FirstAidClient.GetAllAsync();
            _confirmDeleteOpen = false;
            _editSheetOpen = false;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login?returnUrl=/first-aid", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _deleteError = "The item could not be deleted.";
        }
        finally { _isDeleting = false; }
    }
}