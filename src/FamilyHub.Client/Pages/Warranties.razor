@page "/warranties"
@using FamilyHub.Services
@inject WarrantyClient WarrantyClient
@inject HouseholdClient HouseholdClient
@inject NavigationManager Navigation

<PageTitle>Warranties | Family Hub</PageTitle>

<AppBar Title="Warranties">
    <Trail>
        <button type="button" class="icon-btn" aria-label="Add warranty" @onclick="() => _sheetOpen = true">
            <Icon Name="plus" />
        </button>
    </Trail>
</AppBar>

<div class="page">
    @if (_isLoading)
    {
        <div class="state" role="status">Loading warranties</div>
    }
    else if (_loadError is not null)
    {
        <div class="notice" role="alert">
            <span>@_loadError</span>
            <button type="button" class="btn-text" @onclick="LoadAsync">Retry</button>
        </div>
    }
    else
    {
        <div class="section-head">
            <h2>Register</h2>
            <span>@_items.Count</span>
        </div>
        <div class="card">
            @if (_items.Count == 0)
            {
                <div class="empty">
                    <strong>No warranties yet</strong>
                    <span>Tap + to file a receipt into Paperless-ngx.</span>
                </div>
            }
            else
            {
                @foreach (var item in _items)
                {
                    <div class="row">
                        @if (item.DocumentExternalId is not null)
                        {
                            <button type="button" class="avatar avatar-button" aria-label="View @item.Name document"
                                    @onclick="() => OpenPreview(item)">
                                <img src="@GetThumbnailUrl(item)" alt="" loading="lazy" />
                            </button>
                        }
                        else
                        {
                            <span class="avatar">
                                <Icon Name="warranty" />
                            </span>
                        }
                        <button type="button" class="row-hit" @onclick="() => OpenEdit(item)">
                            <div class="row-main">
                                <div class="row-title">@item.Name</div>
                                <div class="row-sub">@GetPurchaseText(item)</div>
                            </div>
                            <div class="row-trail row-trail-stack">
                                <span class="row-value">@GetWarrantyText(item)</span>
                                <span class="chip">
                                    @(item.DocumentExternalId is null ? "No document" : "Document")
                                </span>
                            </div>
                        </button>
                    </div>
                }
            }
        </div>
    }
</div>

<Sheet @bind-Open="_sheetOpen" Title="New warranty">
    <form class="fields" @onsubmit="CreateAsync" @onsubmit:preventDefault>
        <label class="field">
            <span>Item</span>
            <input required maxlength="120" placeholder="e.g. Washing machine" @bind="_name" />
        </label>
        <div class="field-pair">
            <label class="field">
                <span>Purchased</span>
                <input type="date" @bind="_purchasedOn" />
            </label>
            <label class="field">
                <span>Covered until</span>
                <input type="date" @bind="_warrantyExpiresOn" />
            </label>
        </div>
        <label class="field">
            <span>Receipt or warranty photo</span>
            <InputFile @key="_fileInputKey" OnChange="SelectDocument" accept="image/*" capture="environment" required />
        </label>
        <button type="submit" class="btn btn-primary btn-block" disabled="@(_isSaving || _document is null)">
            @(_isSaving ? "Uploading" : "Add warranty")
        </button>
    </form>
    @if (_saveError is not null)
    {
        <p class="form-error" role="alert">@_saveError</p>
    }
</Sheet>

<Sheet @bind-Open="_previewOpen" Title="@(_previewItem?.Name ?? "Document")">
    @if (_previewItem is not null)
    {
        <img class="preview-image" src="@GetPreviewUrl(_previewItem)" alt="" />
    }
</Sheet>

<Sheet @bind-Open="_editSheetOpen" Title="Edit warranty">
    <form class="fields" @onsubmit="UpdateAsync" @onsubmit:preventDefault>
        <label class="field">
            <span>Item</span>
            <input required maxlength="120" @bind="_editName" />
        </label>
        <div class="field-pair">
            <label class="field">
                <span>Purchased</span>
                <input type="date" @bind="_editPurchasedOn" />
            </label>
            <label class="field">
                <span>Covered until</span>
                <input type="date" @bind="_editWarrantyExpiresOn" />
            </label>
        </div>
        <label class="field">
            <span>Replace receipt or warranty photo</span>
            <InputFile @key="_editFileInputKey" OnChange="SelectReplacementDocument" accept="image/*"
                       capture="environment" />
        </label>
        <button type="submit" class="btn btn-primary btn-block" disabled="@_isSaving">
            @(_isSaving ? "Saving" : "Save changes")
        </button>
        <button type="button" class="btn-text" @onclick="() => _confirmDeleteOpen = true">Delete warranty</button>
    </form>
    @if (_editError is not null)
    {
        <p class="form-error" role="alert">@_editError</p>
    }
</Sheet>

<ConfirmDialog @bind-Open="_confirmDeleteOpen" Title="Delete warranty" Message="@_deleteMessage" OnConfirm="DeleteAsync"
               Error="@_deleteError" IsBusy="_isDeleting" />

@code {
    private IReadOnlyList<WarrantyItem> _items = [];
    private string _name = string.Empty;
    private DateOnly? _purchasedOn = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly? _warrantyExpiresOn;
    private IBrowserFile? _document;
    private int _fileInputKey;
    private string? _loadError;
    private string? _saveError;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _sheetOpen;
    private bool _previewOpen;
    private WarrantyItem? _previewItem;

    private WarrantyItem? _editItem;
    private string _editName = string.Empty;
    private DateOnly? _editPurchasedOn;
    private DateOnly? _editWarrantyExpiresOn;
    private IBrowserFile? _editDocument;
    private int _editFileInputKey;
    private string? _editError;
    private bool _editSheetOpen;
    private bool _confirmDeleteOpen;
    private string? _deleteError;
    private bool _isDeleting;
    private string _deleteMessage = string.Empty;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadError = null;
        try
        {
            if (await HouseholdClient.GetMineAsync() is null)
            {
                _loadError = "Complete Household setup before archiving warranties.";
                return;
            }
            _items = await WarrantyClient.GetAllAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login?returnUrl=/warranties", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _loadError = "Warranties could not be loaded.";
        }
        finally { _isLoading = false; }
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_name) || _document is null) return;
        _isSaving = true;
        _saveError = null;
        try
        {
            await WarrantyClient.CreateWithDocumentAsync(_name.Trim(), _purchasedOn, _warrantyExpiresOn, _document);
            _name = string.Empty;
            _document = null;
            _fileInputKey++;
            _items = await WarrantyClient.GetAllAsync();
            _sheetOpen = false;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login?returnUrl=/warranties", forceLoad: true);
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            _saveError = "Configure Paperless-ngx in Settings before uploading a warranty image.";
        }
        catch (HttpRequestException)
        {
            _saveError = "The warranty image could not be uploaded. Check the file and dates, then try again.";
        }
        finally { _isSaving = false; }
    }

    private void SelectDocument(InputFileChangeEventArgs eventArgs)
    {
        _document = eventArgs.File;
        _saveError = null;
    }

    private void OpenPreview(WarrantyItem item)
    {
        _previewItem = item;
        _previewOpen = true;
    }

    private void OpenEdit(WarrantyItem item)
    {
        _editItem = item;
        _editName = item.Name;
        _editPurchasedOn = item.PurchasedOn;
        _editWarrantyExpiresOn = item.WarrantyExpiresOn;
        _editDocument = null;
        _editFileInputKey++;
        _editError = null;
        _deleteError = null;
        _deleteMessage = $"Delete {item.Name}? This can't be undone.";
        _editSheetOpen = true;
    }

    private void SelectReplacementDocument(InputFileChangeEventArgs eventArgs)
    {
        _editDocument = eventArgs.File;
        _editError = null;
    }

    private async Task UpdateAsync()
    {
        if (_editItem is null || string.IsNullOrWhiteSpace(_editName)) return;
        _isSaving = true;
        _editError = null;
        try
        {
            await WarrantyClient.UpdateAsync(_editItem.ItemId, _editName.Trim(), _editPurchasedOn, _editWarrantyExpiresOn);
            if (_editDocument is not null)
            {
                await WarrantyClient.ReplaceDocumentAsync(_editItem.ItemId, _editDocument);
            }
            _items = await WarrantyClient.GetAllAsync();
            _editSheetOpen = false;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login?returnUrl=/warranties", forceLoad: true);
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            _editError = "Configure Paperless-ngx in Settings before replacing a warranty image.";
        }
        catch (HttpRequestException)
        {
            _editError = "The warranty could not be saved.";
        }
        finally { _isSaving = false; }
    }

    private async Task DeleteAsync()
    {
        if (_editItem is null) return;
        _isDeleting = true;
        _deleteError = null;
        try
        {
            await WarrantyClient.DeleteAsync(_editItem.ItemId);
            _items = await WarrantyClient.GetAllAsync();
            _confirmDeleteOpen = false;
            _editSheetOpen = false;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login?returnUrl=/warranties", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _deleteError = "The warranty could not be deleted.";
        }
        finally { _isDeleting = false; }
    }

    private static string GetPurchaseText(WarrantyItem item) =>
        item.PurchasedOn is null ? "Purchase date not recorded" : $"Purchased {item.PurchasedOn:d MMM yyyy}";

    private static string GetWarrantyText(WarrantyItem item) =>
        item.WarrantyExpiresOn is null ? "No end date" : $"To {item.WarrantyExpiresOn:MMM yyyy}";

    private static string GetThumbnailUrl(WarrantyItem item) =>
        $"/api/warranty-items/{item.ItemId}/document/thumbnail";

    private static string GetPreviewUrl(WarrantyItem item) =>
        $"/api/warranty-items/{item.ItemId}/document/preview";
}