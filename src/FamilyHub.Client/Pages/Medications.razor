@page "/medications"
@using FamilyHub.Services
@inject MedicationClient MedicationClient
@inject HouseholdClient HouseholdClient
@inject PushNotificationClient PushNotificationClient
@inject NavigationManager Navigation

<PageTitle>Medications | Family Hub</PageTitle>

<AppBar Title="Medications">
    <Trail>
        <button type="button" class="icon-btn" aria-label="Add medication" disabled="@(_household is null)"
                @onclick="() => _sheetOpen = true">
            <Icon Name="plus" />
        </button>
    </Trail>
</AppBar>

<div class="page">
    @if (_isLoading)
    {
        <div class="state" role="status">Loading medications</div>
    }
    else if (_loadError is not null)
    {
        <div class="notice" role="alert">
            <span>@_loadError</span>
            <button type="button" class="btn-text" @onclick="LoadAsync">Retry</button>
        </div>
    }
    else if (_household is not null)
    {
        <div class="section-head">
            <h2>Plan</h2>
            <span>@_medications.Count</span>
        </div>

        @if (_actionError is not null)
        {
            <div class="notice" role="alert">@_actionError</div>
        }

        <div class="card">
            @if (_medications.Count == 0)
            {
                <div class="empty">
                    <strong>No medications</strong>
                    <span>Tap + to add a Scheduled or PRN Medication.</span>
                </div>
            }
            else
            {
                @foreach (var medication in _medications)
                {
                    <div class="row">
                        <button type="button" class="row-hit" @onclick="() => OpenEditMedication(medication)">
                            <span class="avatar">
                                <Icon Name="meds" />
                            </span>
                            <div class="row-main">
                                <div class="row-title">@medication.Name</div>
                                <div class="row-sub">@medication.Dosage · @GetScheduleText(medication)</div>
                            </div>
                        </button>
                        <div class="row-trail row-trail-stack">
                            <span class="chip">@(medication.Kind == "Prn" ? "PRN" : "Scheduled")</span>
                            <button type="button" class="btn btn-sm" disabled="@(_loggingMedicationId == medication.MedicationId)"
                                    @onclick="() => LogTakenAsync(medication)">
                                @(_loggingMedicationId == medication.MedicationId ? "Logging" : "Log dose")
                            </button>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="section-head">
            <h2>Reminders</h2>
        </div>
        <div class="card">
            <div class="row">
                <span class="avatar">
                    <Icon Name="bell" />
                </span>
                <div class="row-main">
                    <div class="row-title">Push notifications</div>
                    <div class="row-sub">@GetNotificationDescription()</div>
                </div>
                <div class="row-trail">
                    <button type="button" class="btn btn-sm" disabled="@_isEnablingNotifications"
                            @onclick="EnableNotificationsAsync">
                        @(_isEnablingNotifications ? "Working" : _notificationPermission == "granted" ? "Refresh" :
  "Enable")
                    </button>
                </div>
            </div>
            @if (_pushSubscriptionId is not null)
            {
                <div class="row">
                    <span class="avatar">
                        <Icon Name="chores" />
                    </span>
                    <div class="row-main">
                        <div class="row-title">Test notification</div>
                        <div class="row-sub">Check this device receives reminders</div>
                    </div>
                    <div class="row-trail">
                        <button type="button" class="btn btn-sm" disabled="@_isSendingTest"
                                @onclick="SendTestNotificationAsync">
                            @(_isSendingTest ? "Sending" : "Send")
                        </button>
                    </div>
                </div>
            }
        </div>
        @if (_notificationError is not null)
        {
            <p class="form-error" role="alert">@_notificationError</p>
        }

        @if (_doseLogs.Count > 0)
        {
            <div class="section-head">
                <h2>Recent Dose Logs</h2>
                <span>Latest first</span>
            </div>
            <div class="card">
                @foreach (var log in _doseLogs.Take(8))
                {
                    <button type="button" class="row row-link" @onclick="() => OpenEditDoseLog(log)">
                        <div class="row-main">
                            <div class="row-title">@GetMedicationName(log.MedicationId)</div>
                            <div class="row-sub">@log.LoggedAt.LocalDateTime.ToString("ddd d MMM, h:mm tt")</div>
                        </div>
                        <div class="row-trail">
                            <span class="chip">@log.Status</span>
                        </div>
                    </button>
                }
            </div>
        }
    }
</div>

<Sheet @bind-Open="_sheetOpen" Title="New medication">
    <form class="fields" @onsubmit="CreateAsync" @onsubmit:preventDefault>
        <label class="field">
            <span>Medication</span>
            <input required maxlength="120" placeholder="e.g. Vitamin D" @bind="_name" />
        </label>
        <label class="field">
            <span>Dosage</span>
            <input required maxlength="120" placeholder="e.g. 1 tablet" @bind="_dosage" />
        </label>
        <div class="field">
            <span>Type</span>
            <div class="segmented">
                <button type="button" class="@(_kind == "Scheduled" ? "is-on" : null)"
                        @onclick='() => _kind = "Scheduled"'>Scheduled</button>
                <button type="button" class="@(_kind == "Prn" ? "is-on" : null)"
                        @onclick='() => _kind = "Prn"'>PRN</button>
            </div>
        </div>
        @if (_kind == "Scheduled")
        {
            <label class="field">
                <span>Daily time</span>
                <input type="time" required @bind="_scheduledTime" />
            </label>
        }
        else
        {
            <label class="field">
                <span>Minimum hours between doses</span>
                <input type="number" min="1" required @bind="_minimumHoursBetweenDoses" />
            </label>
        }
        <button type="submit" class="btn btn-primary btn-block" disabled="@_isSaving">
            @(_isSaving ? "Adding" : "Add medication")
        </button>
    </form>
    @if (_saveError is not null)
    {
        <p class="form-error" role="alert">@_saveError</p>
    }
</Sheet>

<Sheet @bind-Open="_editMedicationSheetOpen" Title="Edit medication">
    <form class="fields" @onsubmit="UpdateMedicationAsync" @onsubmit:preventDefault>
        <label class="field">
            <span>Medication</span>
            <input required maxlength="120" @bind="_editName" />
        </label>
        <label class="field">
            <span>Dosage</span>
            <input required maxlength="120" @bind="_editDosage" />
        </label>
        <div class="field">
            <span>Type</span>
            <div class="segmented">
                <button type="button" class="@(_editKind == "Scheduled" ? "is-on" : null)"
                        @onclick='() => _editKind = "Scheduled"'>Scheduled</button>
                <button type="button" class="@(_editKind == "Prn" ? "is-on" : null)"
                        @onclick='() => _editKind = "Prn"'>PRN</button>
            </div>
        </div>
        @if (_editKind == "Scheduled")
        {
            <label class="field">
                <span>Daily time</span>
                <input type="time" required @bind="_editScheduledTime" />
            </label>
        }
        else
        {
            <label class="field">
                <span>Minimum hours between doses</span>
                <input type="number" min="1" required @bind="_editMinimumHoursBetweenDoses" />
            </label>
        }
        <button type="submit" class="btn btn-primary btn-block" disabled="@_isSaving">
            @(_isSaving ? "Saving" : "Save changes")
        </button>
        <button type="button" class="btn-text" @onclick="() => _confirmDeleteMedicationOpen = true">Delete medication</button>
    </form>
    @if (_editMedicationError is not null)
    {
        <p class="form-error" role="alert">@_editMedicationError</p>
    }
</Sheet>

<ConfirmDialog @bind-Open="_confirmDeleteMedicationOpen"
               Title="Delete medication"
               Message="@_deleteMedicationMessage"
               OnConfirm="DeleteMedicationAsync"
               Error="@_deleteMedicationError"
               IsBusy="_isDeletingMedication" />

<Sheet @bind-Open="_editDoseLogSheetOpen" Title="Edit Dose Log">
    <form class="fields" @onsubmit="UpdateDoseLogAsync" @onsubmit:preventDefault>
        <div class="field">
            <span>Status</span>
            <div class="segmented">
                <button type="button" class="@(_editDoseLogStatus == "Taken" ? "is-on" : null)"
                        @onclick='() => _editDoseLogStatus = "Taken"'>Taken</button>
                <button type="button" class="@(_editDoseLogStatus == "Skipped" ? "is-on" : null)"
                        @onclick='() => _editDoseLogStatus = "Skipped"'>Skipped</button>
                <button type="button" class="@(_editDoseLogStatus == "Missed" ? "is-on" : null)"
                        @onclick='() => _editDoseLogStatus = "Missed"'>Missed</button>
            </div>
        </div>
        <button type="submit" class="btn btn-primary btn-block" disabled="@_isSaving">
            @(_isSaving ? "Saving" : "Save changes")
        </button>
        <button type="button" class="btn-text" @onclick="() => _confirmDeleteDoseLogOpen = true">Delete entry</button>
    </form>
    @if (_editDoseLogError is not null)
    {
        <p class="form-error" role="alert">@_editDoseLogError</p>
    }
</Sheet>

<ConfirmDialog @bind-Open="_confirmDeleteDoseLogOpen"
               Title="Delete Dose Log entry"
               Message="Only an exact duplicate entry can be deleted; correct it above instead if it isn't."
               OnConfirm="DeleteDoseLogAsync"
               Error="@_deleteDoseLogError"
               IsBusy="_isDeletingDoseLog" />

@code {
    private HouseholdInfo? _household;
    private IReadOnlyList<MedicationItem> _medications = [];
    private IReadOnlyList<DoseLogItem> _doseLogs = [];
    private string _name = string.Empty;
    private string _dosage = string.Empty;
    private string _kind = "Scheduled";
    private TimeOnly _scheduledTime = new(8, 0);
    private int _minimumHoursBetweenDoses = 6;
    private string? _loadError;
    private string? _saveError;
    private string? _actionError;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _sheetOpen;
    private Guid? _loggingMedicationId;
    private Guid? _pushSubscriptionId;
    private string _notificationPermission = "default";
    private string? _notificationError;
    private bool _isEnablingNotifications;
    private bool _isSendingTest;

    private MedicationItem? _editMedication;
    private string _editName = string.Empty;
    private string _editDosage = string.Empty;
    private string _editKind = "Scheduled";
    private TimeOnly _editScheduledTime = new(8, 0);
    private int _editMinimumHoursBetweenDoses = 6;
    private string? _editMedicationError;
    private bool _editMedicationSheetOpen;
    private bool _confirmDeleteMedicationOpen;
    private string? _deleteMedicationError;
    private bool _isDeletingMedication;
    private string _deleteMedicationMessage = string.Empty;

    private DoseLogItem? _editDoseLog;
    private string _editDoseLogStatus = "Taken";
    private string? _editDoseLogError;
    private bool _editDoseLogSheetOpen;
    private bool _confirmDeleteDoseLogOpen;
    private string? _deleteDoseLogError;
    private bool _isDeletingDoseLog;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadError = null;
        try
        {
            _household = await HouseholdClient.GetMineAsync();
            if (_household is null)
            {
                _loadError = "Complete Household setup before tracking medications.";
                return;
            }
            _medications = await MedicationClient.GetAllAsync();
            _doseLogs = await MedicationClient.GetDoseLogsAsync();
            await LoadNotificationStateAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login?returnUrl=/medications", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _loadError = "Medications could not be loaded.";
        }
        finally { _isLoading = false; }
    }

    private async Task LoadNotificationStateAsync()
    {
        try
        {
            _notificationPermission = await PushNotificationClient.GetPermissionStatusAsync();
            if (_notificationPermission == "granted")
            {
                var registration = await PushNotificationClient.RegisterAsync(requestPermission: false);
                _pushSubscriptionId = registration?.PushSubscriptionId;
            }
        }
        catch (HttpRequestException)
        {
            _notificationError = "Notifications are not configured on this server.";
        }
        catch (JSException)
        {
            _notificationPermission = "unsupported";
            _notificationError = "This browser could not initialize Push notifications.";
        }
    }

    private async Task CreateAsync()
    {
        if (_household is null || string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_dosage)) return;
        _isSaving = true;
        _saveError = null;
        try
        {
            await MedicationClient.CreateAsync(
                _name.Trim(),
                _dosage.Trim(),
                _household.FamilyMemberId,
                _kind,
                _kind == "Scheduled" ? _scheduledTime : null,
                _kind == "Prn" ? _minimumHoursBetweenDoses : null);
            _name = string.Empty;
            _dosage = string.Empty;
            _medications = await MedicationClient.GetAllAsync();
            _sheetOpen = false;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login?returnUrl=/medications", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _saveError = "The medication could not be added.";
        }
        finally { _isSaving = false; }
    }

    private async Task LogTakenAsync(MedicationItem medication)
    {
        _loggingMedicationId = medication.MedicationId;
        _actionError = null;
        try
        {
            await MedicationClient.LogDoseAsync(medication.MedicationId, "Taken");
            _doseLogs = await MedicationClient.GetDoseLogsAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login?returnUrl=/medications", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _actionError = $"A Dose Log could not be added for {medication.Name}.";
        }
        finally { _loggingMedicationId = null; }
    }

    private async Task EnableNotificationsAsync()
    {
        _isEnablingNotifications = true;
        _notificationError = null;
        try
        {
            var registration = await PushNotificationClient.RegisterAsync(requestPermission: true);
            _notificationPermission = registration?.Status ?? "unsupported";
            _pushSubscriptionId = registration?.PushSubscriptionId;
            if (_notificationPermission == "denied")
            {
                _notificationError = "Notifications are blocked in this browser's site settings.";
            }
            else if (_notificationPermission == "unsupported")
            {
                _notificationError = "Push notifications are not supported by this browser.";
            }
        }
        catch (HttpRequestException)
        {
            _notificationError = "Notifications could not be enabled. Check the server Push configuration.";
        }
        catch (JSException)
        {
            _notificationError = "The browser could not create a Push subscription.";
        }
        finally { _isEnablingNotifications = false; }
    }

    private async Task SendTestNotificationAsync()
    {
        if (_pushSubscriptionId is null) return;
        _isSendingTest = true;
        _notificationError = null;
        try
        {
            await PushNotificationClient.SendTestAsync(_pushSubscriptionId.Value);
        }
        catch (HttpRequestException)
        {
            _notificationError = "The test notification could not be sent.";
        }
        finally { _isSendingTest = false; }
    }

    private string GetNotificationDescription() => _notificationPermission switch
    {
        "granted" => "This device receives reminders even when Family Hub is closed.",
        "denied" => "Blocked by this browser. Allow notifications in site settings to continue.",
        "unsupported" => "This browser does not support Web Push.",
        _ => "Enable this device to receive reminders at each scheduled dose time.",
    };

    private static string GetScheduleText(MedicationItem medication) => medication.Kind == "Scheduled"
        ? $"Daily at {medication.ScheduledTime:h\\:mm}"
        : $"At least {medication.MinimumHoursBetweenDoses} hours apart";

    private string GetMedicationName(Guid medicationId) =>
        _medications.FirstOrDefault(medication => medication.MedicationId == medicationId)?.Name ?? "Medication";

    private void OpenEditMedication(MedicationItem medication)
    {
        _editMedication = medication;
        _editName = medication.Name;
        _editDosage = medication.Dosage;
        _editKind = medication.Kind;
        _editScheduledTime = medication.ScheduledTime ?? new TimeOnly(8, 0);
        _editMinimumHoursBetweenDoses = medication.MinimumHoursBetweenDoses ?? 6;
        _editMedicationError = null;
        _deleteMedicationError = null;
        _deleteMedicationMessage = $"Delete {medication.Name}? This can't be undone.";
        _editMedicationSheetOpen = true;
    }

    private async Task UpdateMedicationAsync()
    {
        if (_editMedication is null || string.IsNullOrWhiteSpace(_editName) || string.IsNullOrWhiteSpace(_editDosage)) return;
        _isSaving = true;
        _editMedicationError = null;
        try
        {
            await MedicationClient.UpdateAsync(
                _editMedication.MedicationId,
                _editName.Trim(),
                _editDosage.Trim(),
                _editMedication.AssignedFamilyMemberId,
                _editKind,
                _editKind == "Scheduled" ? _editScheduledTime : null,
                _editKind == "Prn" ? _editMinimumHoursBetweenDoses : null);
            _medications = await MedicationClient.GetAllAsync();
            _editMedicationSheetOpen = false;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login?returnUrl=/medications", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _editMedicationError = "The medication could not be saved.";
        }
        finally { _isSaving = false; }
    }

    private async Task DeleteMedicationAsync()
    {
        if (_editMedication is null) return;
        _isDeletingMedication = true;
        _deleteMedicationError = null;
        try
        {
            await MedicationClient.DeleteAsync(_editMedication.MedicationId);
            _medications = await MedicationClient.GetAllAsync();
            _doseLogs = await MedicationClient.GetDoseLogsAsync();
            _confirmDeleteMedicationOpen = false;
            _editMedicationSheetOpen = false;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login?returnUrl=/medications", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _deleteMedicationError = "The medication could not be deleted.";
        }
        finally { _isDeletingMedication = false; }
    }

    private void OpenEditDoseLog(DoseLogItem log)
    {
        _editDoseLog = log;
        _editDoseLogStatus = log.Status;
        _editDoseLogError = null;
        _deleteDoseLogError = null;
        _editDoseLogSheetOpen = true;
    }

    private async Task UpdateDoseLogAsync()
    {
        if (_editDoseLog is null) return;
        _isSaving = true;
        _editDoseLogError = null;
        try
        {
            await MedicationClient.UpdateDoseLogAsync(_editDoseLog.DoseLogId, _editDoseLogStatus);
            _doseLogs = await MedicationClient.GetDoseLogsAsync();
            _editDoseLogSheetOpen = false;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login?returnUrl=/medications", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _editDoseLogError = "The Dose Log entry could not be saved.";
        }
        finally { _isSaving = false; }
    }

    private async Task DeleteDoseLogAsync()
    {
        if (_editDoseLog is null) return;
        _isDeletingDoseLog = true;
        _deleteDoseLogError = null;
        try
        {
            var deleted = await MedicationClient.TryDeleteDoseLogAsync(_editDoseLog.DoseLogId);
            if (!deleted)
            {
                _deleteDoseLogError = "Only an exact duplicate entry can be deleted. Edit it instead to correct it.";
                return;
            }
            _doseLogs = await MedicationClient.GetDoseLogsAsync();
            _confirmDeleteDoseLogOpen = false;
            _editDoseLogSheetOpen = false;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login?returnUrl=/medications", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _deleteDoseLogError = "The Dose Log entry could not be deleted.";
        }
        finally { _isDeletingDoseLog = false; }
    }
}