@page "/expiry"
@using FamilyHub.Services
@inject ExpiryClient ExpiryClient
@inject HouseholdClient HouseholdClient
@inject NavigationManager Navigation

<PageTitle>Expiry Tracker | Family Hub</PageTitle>

<AppBar Title="Expiry">
    <Trail>
        <button type="button" class="icon-btn" aria-label="Add item" @onclick="() => _sheetOpen = true">
            <Icon Name="plus" />
        </button>
    </Trail>
</AppBar>

<div class="page">
    @if (_isLoading)
    {
        <div class="state" role="status">Loading items</div>
    }
    else if (_loadError is not null)
    {
        <div class="notice" role="alert">
            <span>@_loadError</span>
            <button type="button" class="btn-text" @onclick="LoadAsync">Retry</button>
        </div>
    }
    else
    {
        <div class="section-head">
            <h2>Expiring soonest</h2>
            <span>@_items.Count</span>
        </div>
        <div class="card">
            @if (_items.Count == 0)
            {
                <div class="empty">
                    <strong>Nothing tracked yet</strong>
                    <span>Tap + to add an Item with an expiry date.</span>
                </div>
            }
            else
            {
                @foreach (var item in _items)
                {
                    <button type="button" class="row row-link" @onclick="() => OpenEdit(item)">
                        <div class="datechip @(IsAlert(item) ? "is-alert" : null)">
                            <span>@item.ExpiresOn.ToString("MMM")</span>
                            <strong>@item.ExpiresOn.Day</strong>
                        </div>
                        <div class="row-main">
                            <div class="row-title">@item.Name</div>
                            <div class="row-sub">Reminder @item.LeadTimeDays @(item.LeadTimeDays == 1 ? "day" : "days") before</div>
                        </div>
                        <div class="row-trail">
                            <span class="chip @GetExpiryClass(item)">@GetExpiryLabel(item)</span>
                        </div>
                    </button>
                }
            }
        </div>
    }
</div>

<Sheet @bind-Open="_sheetOpen" Title="New expiring item">
    <form class="fields" @onsubmit="CreateAsync" @onsubmit:preventDefault>
        <label class="field">
            <span>Item</span>
            <input required maxlength="120" placeholder="e.g. Milk" @bind="_name" />
        </label>
        <div class="field-pair">
            <label class="field">
                <span>Expires on</span>
                <input type="date" required @bind="_expiresOn" />
            </label>
            <label class="field">
                <span>Lead Time (days)</span>
                <input type="number" min="0" max="3650" required @bind="_leadTimeDays" />
            </label>
        </div>
        <button type="submit" class="btn btn-primary btn-block" disabled="@_isSaving">
            @(_isSaving ? "Adding" : "Add item")
        </button>
    </form>
    @if (_saveError is not null)
    {
        <p class="form-error" role="alert">@_saveError</p>
    }
</Sheet>

<Sheet @bind-Open="_editSheetOpen" Title="Edit item">
    <form class="fields" @onsubmit="UpdateAsync" @onsubmit:preventDefault>
        <label class="field">
            <span>Item</span>
            <input required maxlength="120" @bind="_editName" />
        </label>
        <div class="field-pair">
            <label class="field">
                <span>Expires on</span>
                <input type="date" required @bind="_editExpiresOn" />
            </label>
            <label class="field">
                <span>Lead Time (days)</span>
                <input type="number" min="0" max="3650" required @bind="_editLeadTimeDays" />
            </label>
        </div>
        <button type="submit" class="btn btn-primary btn-block" disabled="@_isSaving">
            @(_isSaving ? "Saving" : "Save changes")
        </button>
        <button type="button" class="btn-text" @onclick="() => _confirmDeleteOpen = true">Delete item</button>
    </form>
    @if (_editError is not null)
    {
        <p class="form-error" role="alert">@_editError</p>
    }
</Sheet>

<ConfirmDialog @bind-Open="_confirmDeleteOpen"
               Title="Delete item"
               Message="@_deleteMessage"
               OnConfirm="DeleteAsync"
               Error="@_deleteError"
               IsBusy="_isDeleting" />

@code {
    private IReadOnlyList<ExpiryItem> _items = [];
    private string _name = string.Empty;
    private DateOnly _expiresOn = DateOnly.FromDateTime(DateTime.Today.AddDays(7));
    private int _leadTimeDays = 3;
    private string? _loadError;
    private string? _saveError;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _sheetOpen;

    private ExpiryItem? _editItem;
    private string _editName = string.Empty;
    private DateOnly _editExpiresOn;
    private int _editLeadTimeDays;
    private string? _editError;
    private bool _editSheetOpen;
    private bool _confirmDeleteOpen;
    private string? _deleteError;
    private bool _isDeleting;
    private string _deleteMessage = string.Empty;

    private static bool IsAlert(ExpiryItem item) =>
        item.ExpiresOn <= DateOnly.FromDateTime(DateTime.Today);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadError = null;
        try
        {
            if (await HouseholdClient.GetMineAsync() is null)
            {
                _loadError = "Complete Household setup before tracking expiry dates.";
                return;
            }
            _items = await ExpiryClient.GetAllAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login?returnUrl=/expiry", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _loadError = "Expiring items could not be loaded.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_name)) return;
        _isSaving = true;
        _saveError = null;
        try
        {
            await ExpiryClient.CreateAsync(_name.Trim(), _expiresOn, _leadTimeDays);
            _name = string.Empty;
            _items = await ExpiryClient.GetAllAsync();
            _sheetOpen = false;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login?returnUrl=/expiry", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _saveError = "The expiring item could not be added.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void OpenEdit(ExpiryItem item)
    {
        _editItem = item;
        _editName = item.Name;
        _editExpiresOn = item.ExpiresOn;
        _editLeadTimeDays = item.LeadTimeDays;
        _editError = null;
        _deleteError = null;
        _deleteMessage = $"Delete {item.Name}? This can't be undone.";
        _editSheetOpen = true;
    }

    private async Task UpdateAsync()
    {
        if (_editItem is null || string.IsNullOrWhiteSpace(_editName)) return;
        _isSaving = true;
        _editError = null;
        try
        {
            await ExpiryClient.UpdateAsync(_editItem.ItemId, _editName.Trim(), _editExpiresOn, _editLeadTimeDays);
            _items = await ExpiryClient.GetAllAsync();
            _editSheetOpen = false;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login?returnUrl=/expiry", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _editError = "The item could not be saved.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_editItem is null) return;
        _isDeleting = true;
        _deleteError = null;
        try
        {
            await ExpiryClient.DeleteAsync(_editItem.ItemId);
            _items = await ExpiryClient.GetAllAsync();
            _confirmDeleteOpen = false;
            _editSheetOpen = false;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login?returnUrl=/expiry", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _deleteError = "The item could not be deleted.";
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private static int DaysUntil(ExpiryItem item) =>
        item.ExpiresOn.DayNumber - DateOnly.FromDateTime(DateTime.Today).DayNumber;

    private static string GetExpiryClass(ExpiryItem item) =>
        DaysUntil(item) < 0 ? "chip-danger" : DaysUntil(item) <= item.LeadTimeDays ? "chip-warn" : string.Empty;

    private static string GetExpiryLabel(ExpiryItem item) => DaysUntil(item) switch
    {
        < 0 => "Expired",
        0 => "Today",
        1 => "Tomorrow",
        var days => $"{days} days",
    };
}