@page "/chores"
@using FamilyHub.Services
@inject ChoreClient ChoreClient
@inject HouseholdClient HouseholdClient
@inject NavigationManager Navigation

<PageTitle>Chores | Family Hub</PageTitle>

<AppBar Title="Chores">
    <Trail>
        <button type="button" class="icon-btn" aria-label="Add chore" disabled="@(_household is null)"
                @onclick="() => _sheetOpen = true">
            <Icon Name="plus" />
        </button>
    </Trail>
</AppBar>

<div class="page">
    @if (_isLoading)
    {
        <div class="state" role="status">Loading chores</div>
    }
    else if (_loadError is not null)
    {
        <div class="notice" role="alert">
            <span>@_loadError</span>
            <button type="button" class="btn-text" @onclick="LoadAsync">Retry</button>
        </div>
    }
    else if (_household is not null)
    {
        @if (_actionError is not null)
        {
            <div class="notice" role="alert">@_actionError</div>
        }

        <div class="section-head">
            <h2>To do</h2>
            <span>@DateTime.Today.ToString("ddd d MMM")</span>
        </div>
        <div class="card">
            @if (_open.Count == 0)
            {
                <div class="empty">
                    <strong>Nothing to do</strong>
                    <span>Tap + to add a chore.</span>
                </div>
            }
            else
            {
                @foreach (var chore in _open)
                {
                    <div class="row">
                        <button type="button" class="row-link row-hit" @onclick="() => OpenEdit(chore)">
                            <div
                                class="datechip @(chore.ScheduledDate <= DateOnly.FromDateTime(DateTime.Today) ? "is-alert" : null)">
                                <span>@chore.ScheduledDate.ToString("MMM")</span>
                                <strong>@chore.ScheduledDate.Day</strong>
                            </div>
                            <div class="row-main">
                                <div class="row-title">@chore.Title</div>
                                <div class="row-sub">@chore.AssignedDisplayName</div>
                            </div>
                        </button>
                        <div class="row-trail">
                            <button type="button" class="btn btn-sm"
                                    disabled="@(_completingOccurrenceId == chore.ChoreOccurrenceId)"
                                    @onclick="() => CompleteAsync(chore)">
                                @(_completingOccurrenceId == chore.ChoreOccurrenceId ? "Saving" : "Done")
                            </button>
                        </div>
                    </div>
                }
            }
        </div>

        @if (_done.Count > 0)
        {
            <div class="section-head">
                <h2>Completed</h2>
                <span>@_done.Count</span>
            </div>
            <div class="card">
                @foreach (var chore in _done)
                {
                    <button type="button" class="row row-link is-done" @onclick="() => OpenEdit(chore)">
                        <div class="datechip">
                            <span>@chore.ScheduledDate.ToString("MMM")</span>
                            <strong>@chore.ScheduledDate.Day</strong>
                        </div>
                        <div class="row-main">
                            <div class="row-title">@chore.Title</div>
                            <div class="row-sub">@chore.AssignedDisplayName</div>
                        </div>
                        <div class="row-trail">
                            <span class="chip chip-ok">Done</span>
                        </div>
                    </button>
                }
            </div>
        }
    }
</div>

<Sheet @bind-Open="_sheetOpen" Title="New chore">
    <form class="fields" @onsubmit="CreateAsync" @onsubmit:preventDefault>
        <label class="field">
            <span>Chore</span>
            <input required maxlength="120" placeholder="e.g. Take the bins out" @bind="_title" />
        </label>
        <label class="field">
            <span>Due date</span>
            <input type="date" required @bind="_scheduledDate" />
        </label>
        <button type="submit" class="btn btn-primary btn-block" disabled="@_isSaving">
            @(_isSaving ? "Adding" : "Add chore")
        </button>
    </form>
    @if (_saveError is not null)
    {
        <p class="form-error" role="alert">@_saveError</p>
    }
</Sheet>

<Sheet @bind-Open="_editSheetOpen" Title="Edit chore">
    <form class="fields" @onsubmit="UpdateAsync" @onsubmit:preventDefault>
        <label class="field">
            <span>Chore</span>
            <input required maxlength="120" @bind="_editTitle" />
        </label>
        <label class="field">
            <span>Due date</span>
            <input type="date" required @bind="_editScheduledDate" />
        </label>
        <button type="submit" class="btn btn-primary btn-block" disabled="@_isSaving">
            @(_isSaving ? "Saving" : "Save changes")
        </button>
        <button type="button" class="btn-text" @onclick="() => _confirmDeleteOpen = true">Delete chore</button>
    </form>
    @if (_editError is not null)
    {
        <p class="form-error" role="alert">@_editError</p>
    }
</Sheet>

<ConfirmDialog @bind-Open="_confirmDeleteOpen" Title="Delete chore" Message="@_deleteMessage" OnConfirm="DeleteAsync"
               Error="@_deleteError" IsBusy="_isDeleting" />

@code {
    private HouseholdInfo? _household;
    private string _title = string.Empty;
    private DateOnly _scheduledDate = DateOnly.FromDateTime(DateTime.Today);
    private string? _loadError;
    private string? _saveError;
    private string? _actionError;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _sheetOpen;
    private Guid? _completingOccurrenceId;

    private ChoreListItem? _editChore;
    private string _editTitle = string.Empty;
    private DateOnly _editScheduledDate;
    private string? _editError;
    private bool _editSheetOpen;
    private bool _confirmDeleteOpen;
    private string? _deleteError;
    private bool _isDeleting;
    private string _deleteMessage = string.Empty;

    private IReadOnlyList<ChoreListItem> _open = [];
    private IReadOnlyList<ChoreListItem> _done = [];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadError = null;

        try
        {
            _household = await HouseholdClient.GetMineAsync();
            if (_household is null)
            {
                _loadError = "Complete Household setup before adding chores.";
                return;
            }

            SetChores(await ChoreClient.GetAllAsync());
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login?returnUrl=/chores", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _loadError = "Chores could not be loaded.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CreateAsync()
    {
        if (_household is null || string.IsNullOrWhiteSpace(_title))
        {
            return;
        }

        _isSaving = true;
        _saveError = null;

        try
        {
            await ChoreClient.CreateAsync(
                _title.Trim(),
                _household.FamilyMemberId,
                _scheduledDate);

            _title = string.Empty;
            _scheduledDate = DateOnly.FromDateTime(DateTime.Today);
            SetChores(await ChoreClient.GetAllAsync());
            _sheetOpen = false;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login?returnUrl=/chores", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _saveError = "The chore could not be added.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task CompleteAsync(ChoreListItem chore)
    {
        _completingOccurrenceId = chore.ChoreOccurrenceId;
        _actionError = null;

        try
        {
            await ChoreClient.CompleteAsync(chore.ChoreOccurrenceId);
            SetChores(await ChoreClient.GetAllAsync());
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login?returnUrl=/chores", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _actionError = $"{chore.Title} could not be marked done.";
        }
        finally
        {
            _completingOccurrenceId = null;
        }
    }

    private void OpenEdit(ChoreListItem chore)
    {
        _editChore = chore;
        _editTitle = chore.Title;
        _editScheduledDate = chore.ScheduledDate;
        _editError = null;
        _deleteError = null;
        _deleteMessage = $"Delete {chore.Title}? This can't be undone.";
        _editSheetOpen = true;
    }

    private async Task UpdateAsync()
    {
        if (_editChore is null || string.IsNullOrWhiteSpace(_editTitle)) return;
        _isSaving = true;
        _editError = null;
        try
        {
            await ChoreClient.UpdateAsync(
                _editChore.ChoreId,
                _editTitle.Trim(),
                _editChore.AssignedFamilyMemberId,
                _editScheduledDate);
            SetChores(await ChoreClient.GetAllAsync());
            _editSheetOpen = false;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login?returnUrl=/chores", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _editError = "The chore could not be saved.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_editChore is null) return;
        _isDeleting = true;
        _deleteError = null;
        try
        {
            await ChoreClient.DeleteAsync(_editChore.ChoreId);
            SetChores(await ChoreClient.GetAllAsync());
            _confirmDeleteOpen = false;
            _editSheetOpen = false;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login?returnUrl=/chores", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _deleteError = "The chore could not be deleted.";
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private void SetChores(IReadOnlyList<ChoreListItem> chores)
    {
        _open = [.. chores.Where(chore => chore.CompletedAt is null)];
        _done = [.. chores.Where(chore => chore.CompletedAt is not null)];
    }
}