@page "/settings"
@using FamilyHub.Services
@inject PaperlessSettingsClient PaperlessSettingsClient
@inject HouseholdClient HouseholdClient
@inject NavigationManager Navigation

<PageTitle>Settings | Family Hub</PageTitle>

<div class="tracker-page">
    <header class="tracker-header">
        <div><p class="tracker-eyebrow">Household Integrations</p><h1>Settings</h1></div>
        <span>Shared by everyone in this Household</span>
    </header>

    @if (_isLoading)
    {
        <div class="tracker-state" role="status">Loading settings...</div>
    }
    else if (_loadError is not null)
    {
        <div class="tracker-notice tracker-error" role="alert"><span>@_loadError</span><button type="button" class="tracker-text-action" @onclick="LoadAsync">Try again</button></div>
    }
    else
    {
        <section class="tracker-editor" aria-labelledby="paperless-heading">
            <div class="tracker-section-heading">
                <h2 id="paperless-heading">Paperless-ngx</h2>
                <span>@(_configured ? "Connected credentials saved" : "Not configured")</span>
            </div>
            <form class="tracker-form" @onsubmit="SaveAsync" @onsubmit:preventDefault>
                <label class="tracker-field-wide"><span>Server URL</span><input type="url" required maxlength="2048" placeholder="https://paperless.example.com" @bind="_baseUrl" /></label>
                <label class="tracker-field-wide"><span>API token</span><input type="password" required maxlength="512" autocomplete="new-password" placeholder="Enter a new API token" @bind="_apiToken" /></label>
                <button type="submit" class="tracker-primary" disabled="@_isSaving">@(_isSaving ? "Saving..." : "Save Paperless settings")</button>
            </form>
            @if (_saveError is not null)
            {
                <p class="tracker-form-error" role="alert">@_saveError</p>
            }
            else if (_saved)
            {
                <p class="tracker-form-success" role="status">Paperless-ngx settings saved.</p>
            }
        </section>
    }
</div>

@code {
    private string _baseUrl = string.Empty;
    private string _apiToken = string.Empty;
    private string? _loadError;
    private string? _saveError;
    private bool _configured;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _saved;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadError = null;
        try
        {
            if (await HouseholdClient.GetMineAsync() is null)
            {
                _loadError = "Complete Household setup before configuring integrations.";
                return;
            }

            var settings = await PaperlessSettingsClient.GetAsync();
            _baseUrl = settings.BaseUrl ?? string.Empty;
            _configured = settings.Configured;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login?returnUrl=/settings", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _loadError = "Settings could not be loaded.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_baseUrl) || string.IsNullOrWhiteSpace(_apiToken))
        {
            return;
        }

        _isSaving = true;
        _saveError = null;
        _saved = false;
        try
        {
            await PaperlessSettingsClient.SaveAsync(_baseUrl.Trim(), _apiToken.Trim());
            _apiToken = string.Empty;
            _configured = true;
            _saved = true;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login?returnUrl=/settings", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _saveError = "Paperless-ngx settings could not be saved. Check the URL and token.";
        }
        finally
        {
            _isSaving = false;
        }
    }
}