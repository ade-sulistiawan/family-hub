@page "/settings"
@using FamilyHub.Services
@inject PaperlessSettingsClient PaperlessSettingsClient
@inject HouseholdClient HouseholdClient
@inject NavigationManager Navigation

<PageTitle>Settings | Family Hub</PageTitle>

<AppBar Title="Settings" />

<div class="page">
    @if (_isLoading)
    {
        <div class="state" role="status">Loading settings</div>
    }
    else if (_loadError is not null)
    {
        <div class="notice" role="alert">
            <span>@_loadError</span>
            <button type="button" class="btn-text" @onclick="LoadAsync">Retry</button>
        </div>
    }
    else
    {
        <div class="section-head">
            <h2>Paperless-ngx</h2>
            <span>@(_configured ? "Connected" : "Not configured")</span>
        </div>
        <div class="card" style="padding:16px">
            <form class="fields" @onsubmit="SaveAsync" @onsubmit:preventDefault>
                <label class="field">
                    <span>Server URL</span>
                    <input type="url" required maxlength="2048" inputmode="url" autocomplete="off"
                           placeholder="https://paperless.example.com" @bind="_baseUrl" />
                </label>
                <label class="field">
                    <span>API token</span>
                    <input type="password" required maxlength="512" autocomplete="new-password"
                           placeholder="Enter a new API token" @bind="_apiToken" />
                </label>
                <button type="submit" class="btn btn-primary btn-block" disabled="@_isSaving">
                    @(_isSaving ? "Saving" : "Save")
                </button>
            </form>
            @if (_saveError is not null)
            {
                <p class="form-error" role="alert">@_saveError</p>
            }
            else if (_saved)
            {
                <p class="form-ok" role="status">Settings saved.</p>
            }
        </div>
    }
</div>

@code {
    private string _baseUrl = string.Empty;
    private string _apiToken = string.Empty;
    private string? _loadError;
    private string? _saveError;
    private bool _configured;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _saved;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadError = null;
        try
        {
            if (await HouseholdClient.GetMineAsync() is null)
            {
                _loadError = "Complete Household setup before configuring integrations.";
                return;
            }

            var settings = await PaperlessSettingsClient.GetAsync();
            _baseUrl = settings.BaseUrl ?? string.Empty;
            _configured = settings.Configured;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login?returnUrl=/settings", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _loadError = "Settings could not be loaded.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_baseUrl) || string.IsNullOrWhiteSpace(_apiToken))
        {
            return;
        }

        _isSaving = true;
        _saveError = null;
        _saved = false;
        try
        {
            await PaperlessSettingsClient.SaveAsync(_baseUrl.Trim(), _apiToken.Trim());
            _apiToken = string.Empty;
            _configured = true;
            _saved = true;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login?returnUrl=/settings", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _saveError = "Paperless-ngx settings could not be saved. Check the URL and token.";
        }
        finally
        {
            _isSaving = false;
        }
    }
}